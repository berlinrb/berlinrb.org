<%- talks = site.latest_talks -%>
<%- if talks.any? -%>
<%- meetup = talks.first["meetup"] -%>
<section class="latest-talk" aria-labelledby="latest-title">
  <div class="section-head">
    <h2 id="latest-title">Latest talks</h2>
    <a href="/talks/">All talks &rarr;</a>
  </div>
  <p class="latest-from">From <a href="<%= site.meetup_path(meetup) %>">Berlin.rb #<%= meetup["number"] %></a> on <%= site.long_date(meetup["date"]) %><%= " at #{h meetup["venue"]}" if meetup["venue"] %>.</p>
  <ul class="latest-talks-list">
<%- talks.each do |talk| -%>
    <li>
<%- if talk["video"] -%>
      <div class="talk-thumb">
<%- if site.thumbnail?(talk["video"]) -%>
        <img src="<%= site.thumbnail(talk["video"]) %>" alt="" width="1280" height="720" loading="lazy">
<%- end -%>
      </div>
<%- end -%>
      <h3><a class="card-link" href="<%= site.talk_path(talk) %>"><%= h talk["title"] %></a></h3>
      <p class="latest-speaker"><%= h talk["speaker"] %></p>
<%- unless (blurb = site.blurb(talk)).empty? -%>
      <p class="latest-abstract"><%= h site.excerpt(blurb, 26) %></p>
<%- end -%>
      <%= site.render_card_arrow %>
    </li>
<%- end -%>
  </ul>
</section>
<%- end -%>
