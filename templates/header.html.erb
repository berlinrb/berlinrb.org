<%# Two logos rather than a <picture>: a <source> media query sees only the system preference, not the theme toggle. -%>
<header class="site-header">
  <a class="site-logo" href="/" aria-label="Berlin.rb home"><img class="logo-light" src="/assets/logotype.svg" alt="Berlin.rb" width="618" height="195"><img class="logo-dark" src="/assets/logotype-dark.svg" alt="Berlin.rb" width="618" height="195"></a>
  <nav class="site-nav" aria-label="Main">
<%- [["Meetups", "/meetups/"], ["Talks", "/talks/"], ["Photos", "/photos/"], ["Get involved", "/get-involved/"]].each do |label, href| -%>
    <a href="<%= href %>"<%= ' aria-current="page"' if current == href %>><%= label %></a>
<%- end -%>
    <a class="button site-nav-cta" href="/get-involved/#speak">Submit a talk</a>
  </nav>
</header>
