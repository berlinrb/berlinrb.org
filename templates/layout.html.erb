<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h title %></title>
    <meta name="description" content="<%= h description %>">
    <link rel="canonical" href="https://berlinrb.org<%= path %>">
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Berlin.rb">
    <meta property="og:locale" content="en_GB">
    <meta property="og:url" content="https://berlinrb.org<%= path %>">
    <meta property="og:title" content="<%= h title %>">
    <meta property="og:description" content="<%= h description %>">
<%- if image -%>
    <meta property="og:image" content="https://berlinrb.org<%= image %>">
    <meta property="og:image:type" content="image/jpeg">
<%- else -%>
    <meta property="og:image" content="https://berlinrb.org/assets/og.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
<%- end -%>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@berlinrb_org">
    <meta name="twitter:title" content="<%= h title %>">
    <meta name="twitter:description" content="<%= h description %>">
    <meta name="twitter:image" content="https://berlinrb.org<%= image || "/assets/og.png" %>">
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://stats.paolino.me/js/pa-qYMtzApqYH7-B10ozGrEh.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script async src="https://tally.so/widgets/embed.js"></script>
    <link rel="preload" href="/assets/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
    <script defer src="/assets/gallery.js"></script>
    <script type="application/ld+json">
<%= site.json_ld({ "@context" => "https://schema.org", "@graph" => ld }).gsub(/^/, "    ") %>
    </script>
  </head>
  <body>
    <main>
<%= body.strip.gsub(/^(?=.)/, "      ") %>

      <footer class="footer">
        <div class="footer-main">
          <nav class="footer-links" aria-label="Berlin.rb">
            <a href="mailto:hello@berlinrb.org">hello@berlinrb.org</a>
            <a href="https://luma.com/berlinrb">Luma calendar</a>
            <a href="/talks/"<%= ' aria-current="page"' if path == "/talks/" %>>Talks</a>
            <a href="/photos/"<%= ' aria-current="page"' if path == "/photos/" %>>Photos</a>
            <a href="https://tally.so/r/WOWMZL" data-tally-open="WOWMZL" data-tally-layout="modal" data-tally-width="700" data-tally-hide-title="1" data-tally-emoji-text="👋" data-tally-emoji-animation="wave" aria-haspopup="dialog">Submit a talk</a>
            <a href="/press/">Press kit</a>
          </nav>
          <nav class="footer-social" aria-label="Social media">
            <a href="https://www.youtube.com/@berlinrb_org">YouTube</a>
            <a href="https://x.com/berlinrb_org">X</a>
            <a href="https://bsky.app/profile/berlinrb.bsky.social">Bluesky</a>
            <a href="https://www.linkedin.com/company/berlinrb">LinkedIn</a>
          </nav>
        </div>
        <p class="footer-legal">
          <a href="/imprint/">Imprint</a>
          <a href="/privacy/">Privacy</a>
        </p>
      </footer>
    </main>
  </body>
</html>
