<%- meetup = talk["meetup"] -%>
<%- chapters, sections = site.summary_sections(talk).partition { _1["id"] == "chapters" } -%>
<section class="page-hero">
  <p class="eyebrow"><span><a href="<%= site.meetup_path(meetup) %>">Berlin.rb #<%= meetup["number"] %></a>, <time datetime="<%= meetup["date"] %>"><%= site.long_date(meetup["date"]) %></time><%= " · #{h talk["format"]}" if talk["format"] && site.upcoming?(meetup) %></span></p>
  <h1><%= h talk["title"] %></h1>
  <p class="lead">By <%= h talk["speaker"] %></p>
</section>
<%- if talk["video"] -%>

<section class="page-section" aria-label="Recording">
  <div class="player-slot">
    <div class="player" data-player="<%= h talk["video"] %>" data-title="<%= h talk["title"] %>">
      <a class="video-link player-start" href="<%= site.video_url(talk["video"]) %>">
<%- if site.thumbnail?(talk["video"]) -%>
        <img src="<%= site.thumbnail(talk["video"]) %>" alt="" width="1280" height="720">
<%- end -%>
        <span class="video-label">Watch on YouTube</span>
      </a>
    </div>
  </div>
<%- if talk["slides"] -%>
  <p class="player-links"><a href="<%= h talk["slides"] %>">Slides</a></p>
<%- end -%>
</section>
<%- end -%>
<%- chapters.each do |section| -%>

<section class="page-section chapters" id="chapters" aria-labelledby="chapters-title">
  <h2 id="chapters-title"><%= h section["title"] %></h2>
<%= section["html"].gsub(/^/, "  ") %>
</section>
<%- end -%>
<%- unless talk["abstract"].to_s.empty? -%>

<section class="page-section prose" aria-labelledby="abstract-title">
  <h2 id="abstract-title">About the talk</h2>
<%= site.paragraphs(talk["abstract"]).gsub(/^/, "  ") %>
</section>
<%- end -%>
<%- sections.each do |section| -%>

<section class="page-section prose talk-notes" id="<%= section["id"] %>" aria-labelledby="<%= section["id"] %>-title">
<%- if section["id"] == "summary" -%>
  <div class="tip-heading">
    <h2 id="summary-title"><%= h section["title"] %></h2>
    <%= site.render_tip("ai-note", "Written with AI", %(This summary was written with AI from the recording, then checked by Berlin.rb and #{h talk["speaker"]}. Spotted a mistake? Write to <a href="mailto:hello@berlinrb.org">hello@berlinrb.org</a>.)) %>
  </div>
<%- else -%>
  <h2 id="<%= section["id"] %>-title"><%= h section["title"] %></h2>
<%- end -%>
<%= section["html"].gsub(/^/, "  ") %>
</section>
<%- end -%>

<section class="page-section">
  <p class="note"><%= site.upcoming?(meetup) ? "Coming up at" : "Given at" %> <a href="<%= site.meetup_path(meetup) %>">Berlin.rb #<%= meetup["number"] %></a><%= " at #{h meetup["venue"]}" if meetup["venue"] %>.<%= %( <a href="#{h talk["slides"]}">See the slides</a>.) if talk["slides"] && !talk["video"] %> Want to speak too? <a href="/get-involved/#speak">Submit a talk</a>.</p>
<%- markdown = "/#{site.markdown_file(site.talk_path(talk))}" -%>
  <p class="note markdown-links"><span>For AI assistants: <a href="<%= markdown %>">this page as Markdown</a></span><button type="button" class="link-button" data-copy-markdown="<%= markdown %>" hidden>Copy as Markdown</button></p>
</section>
