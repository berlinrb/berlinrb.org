<%- later = site.upcoming.drop(1).first(4) -%>
<%- if later.any? -%>
<section class="home-section" aria-labelledby="coming-up-title">
  <div class="section-head">
    <h2 id="coming-up-title">Coming up</h2>
    <a href="/meetups/">All meetups &rarr;</a>
  </div>
  <ol class="coming-up">
<%- later.each do |meetup| -%>
<%- talks = site.talks_for(meetup) -%>
    <li>
      <a class="coming-card" href="<%= site.meetup_path(meetup) %>">
        <span class="coming-date"><%= meetup["date"].strftime("%a %-d %b") %></span>
        <span class="coming-name">Berlin.rb #<%= meetup["number"] %></span>
        <span class="coming-going" data-live-going="<%= meetup["date"] %>" hidden></span>
        <span class="coming-talks"><%= talks.any? ? h(site.talk_names(meetup).join(" · ")) : "Talks to be announced" %></span>
      </a>
    </li>
<%- end -%>
  </ol>
</section>
<%- end -%>
