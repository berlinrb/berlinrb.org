#!/usr/bin/env sh
# Copy a fresh Basecamp access token from this computer's signed-in basecamp
# CLI into the repository's BASECAMP_TOKEN secret, so the daily sync can read
# the Talks card table. Tokens last two weeks; a daily timer keeps it fresh.
set -eu
basecamp auth token | gh secret set BASECAMP_TOKEN --repo berlinrb/berlinrb.org
echo "BASECAMP_TOKEN updated."
